{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>joshyorko/renovate-config:org-inherited-config"
  ],

  "pre-commit": {
    "enabled": true
  },

  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the Go toolchain required by the container-tool builder.",
      "managerFilePatterns": [
        "/^src/common/container-tools/sources\\.json$/"
      ],
      "matchStrings": [
        "\"go_version\":\\s*\"go(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "golang",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track the RCC version used by the maintenance workflow.",
      "managerFilePatterns": [
        "/^\\.github/workflows/rcc-maintenance\\.ya?ml$/"
      ],
      "matchStrings": [
        "RCC_VERSION:\\s*(?<currentValue>v?\\d+\\.\\d+\\.\\d+)",
        "rcc/releases/download/(?<currentValue>v?\\d+\\.\\d+\\.\\d+)/"
      ],
      "depNameTemplate": "joshyorko/rcc",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "Hold starter Python at 3.15.1 until newer standalone builds are available.",
      "matchManagers": ["mise"],
      "matchPackageNames": ["python"],
      "matchFileNames": ["templates/ror-starter/.mise.toml"],
      "allowedVersions": "<=3.15.1"
    },
    {
      "description": "Keep Go builder images and their required toolchain pin in one PR.",
      "matchPackageNames": ["golang"],
      "matchDatasources": ["docker"],
      "groupName": "Go builder toolchain"
    }
  ]
}
