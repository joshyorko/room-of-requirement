[Unit]
Description=Prepare the Room of Requirement container runtime
Requires=dbus.service systemd-logind.service
After=dbus.service systemd-logind.service
Before=multi-user.target ror-docker.service ror-vscode-user-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=HOME=/home/vscode
Environment=ROR_ENTRYPOINT_INIT_ONLY=1
Environment=ROR_SYSTEMD_CONTAINER=1
ExecStart=/usr/local/bin/entrypoint.sh

[Install]
WantedBy=multi-user.target
